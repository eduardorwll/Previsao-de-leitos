# Copie este arquivo para `.env` localmente (`.env` está no .gitignore e NUNCA deve ser commitado).
# No Google Colab, cadastre `GCP_PROJECT_ID` em Secrets (ícone de chave na barra lateral).

GCP_PROJECT_ID=seu-projeto-gcp-aqui
PREVISAO_DATA_DIR=data
PREVISAO_ARTIFACTS_DIR=artifacts
PREVISAO_LOG_LEVEL=INFO
PREVISAO_MAX_BQ_MB=2000

# Credenciais gratuitas opcionais da API v2 ANA HidroWeb (telemetria@ana.gov.br).
# Sem estas variáveis, o pipeline usa automaticamente o fallback aberto Zenodo IPH-UFRGS.
ANA_HIDROWEB_USER=
ANA_HIDROWEB_PASSWORD=
